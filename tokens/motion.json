      "$type": "duration",
      "$value": "1340ms",
      "$description": "A wait, for the page's opening: the page starts going to white, a beat after the logomark's rings have unlocked (700 to 1100ms). Specific to that animation; not a duration for a move.",
      "$extensions": {
        "status": "experimental"
      }
    },
    "1600": {
      "$type": "duration",
      "$value": "1600ms",
      "$description": "A wait, for a page that opens in a sequence (the navigation and the header come in at 1600ms). Not a duration for a move: nothing plays an easing this long.",
      "$extensions": {
        "status": "experimental"
      }
    },
    "1660": {
      "$type": "duration",
      "$value": "1660ms",
      "$description": "A wait, for the page's opening: the logomark rings' whole move (unlock at 700ms, with the last card, hold, and back at 2140ms, done at 2360ms). Specific to that animation; not a duration for a move.",
      "$extensions": {
        "status": "experimental"
      }
    },
    "2140": {
      "$type": "duration",
      "$value": "2140ms",
      "$description": "A wait, for the page's opening: the header, the sidebar and the bento's sequence start when the page has finished going to white (1340ms + 800ms). Specific to that animation; not a duration for a move.",
