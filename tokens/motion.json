{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "duration": {
    "50":  { "$type": "duration", "$value": "50ms" },
    "100": { "$type": "duration", "$value": "100ms" },
    "150": { "$type": "duration", "$value": "150ms" },
    "200": { "$type": "duration", "$value": "200ms" },
    "250": { "$type": "duration", "$value": "250ms" },
    "400": { "$type": "duration", "$value": "400ms" },
    "700": { "$type": "duration", "$value": "700ms" }
  },
  "easing": {
    "productive": {
      "standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0.38, 0.9] },
      "entrance": { "$type": "cubicBezier", "$value": [0, 0, 0.38, 0.9] },
      "exit":     { "$type": "cubicBezier", "$value": [0.2, 0, 1, 0.9] }
    },
    "expressive": {
      "standard": { "$type": "cubicBezier", "$value": [0.4, 0.1, 0.3, 1] },
      "entrance": { "$type": "cubicBezier", "$value": [0, 0, 0.3, 1] },
      "exit":     { "$type": "cubicBezier", "$value": [0.4, 0.1, 1, 1] }
    }
  },
  "transforms": {
    "entrance":   { "$type": "transition", "$value": { "duration": "{duration.250}", "timingFunction": "{easing.productive.entrance}" } },
    "exit":       { "$type": "transition", "$value": { "duration": "{duration.150}", "timingFunction": "{easing.productive.exit}" } },
    "standard":   { "$type": "transition", "$value": { "duration": "{duration.200}", "timingFunction": "{easing.productive.standard}" } },
    "emphasized": { "$type": "transition", "$value": { "duration": "{duration.400}", "timingFunction": "{easing.expressive.entrance}" } }
  },
  "distance": {
    "sm": { "$type": "dimension", "$value": "8px" },
    "md": { "$type": "dimension", "$value": "16px" },
    "lg": { "$type": "dimension", "$value": "24px" },
    "xl": { "$type": "dimension", "$value": "40px" }
  },
  "springs": {
    "bouncy": { "$type": "custom-spring", "$value": { "bounce": 0.4, "duration": 600 } },
    "gentle": { "$type": "custom-spring", "$value": { "bounce": 0.1, "duration": 400 } },
    "stiff":  { "$type": "custom-spring", "$value": { "bounce": 0.2, "duration": 250 } }
  }
}
