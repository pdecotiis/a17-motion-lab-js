{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "duration": {
    "50": { "$type": "duration", "$value": "50ms", "$extensions": { "status": "system" } },
    "100": { "$type": "duration", "$value": "100ms", "$extensions": { "status": "system" } },
    "150": { "$type": "duration", "$value": "150ms", "$extensions": { "status": "system", "oldNames": ["140"] } },
    "200": { "$type": "duration", "$value": "200ms", "$extensions": { "status": "system", "oldNames": ["220"] } },
    "250": { "$type": "duration", "$value": "250ms", "$extensions": { "status": "system", "oldNames": ["300"] } },
    "400": { "$type": "duration", "$value": "400ms", "$extensions": { "status": "system" } },
    "700": { "$type": "duration", "$value": "700ms", "$extensions": { "status": "system", "oldNames": ["560", "800"] } },
    "1200": { "$type": "duration", "$value": "1200ms", "$extensions": { "status": "system" } }
  },
  "easing": {
    "productive-standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0.38, 0.9], "$extensions": { "status": "system" } },
    "productive-entrance": { "$type": "cubicBezier", "$value": [0, 0, 0.38, 0.9], "$extensions": { "status": "system" } },
    "productive-exit": { "$type": "cubicBezier", "$value": [0.2, 0, 1, 0.9], "$extensions": { "status": "system" } },
    "expressive-standard": { "$type": "cubicBezier", "$value": [0.4, 0.1, 0.3, 1], "$extensions": { "status": "system" } },
    "expressive-entrance": { "$type": "cubicBezier", "$value": [0, 0, 0.3, 1], "$extensions": { "status": "system" } },
    "expressive-exit": { "$type": "cubicBezier", "$value": [0.4, 0.1, 1, 1], "$extensions": { "status": "system" } },
    "linear": { "$type": "cubicBezier", "$value": [0, 0, 1, 1], "$extensions": { "status": "system" } }
  },
  "bounce": {
    "0": { "$type": "number", "$value": 0, "$description": "No bounce: the spring settles without overshoot.", "$extensions": { "status": "experimental" } },
    "25": { "$type": "number", "$value": 0.25, "$description": "Motion's default bounce: a slight overshoot.", "$extensions": { "status": "experimental" } },
    "50": { "$type": "number", "$value": 0.5, "$description": "A clear overshoot.", "$extensions": { "status": "experimental" } }
  },
  "distance": {
    "4": { "$type": "dimension", "$value": "4px", "$extensions": { "status": "system" } },
    "8": { "$type": "dimension", "$value": "8px", "$extensions": { "status": "system" } },
    "12": { "$type": "dimension", "$value": "12px", "$extensions": { "status": "system" } },
    "20": { "$type": "dimension", "$value": "20px", "$extensions": { "status": "system", "oldNames": ["16", "24"] } },
    "32": { "$type": "dimension", "$value": "32px", "$extensions": { "status": "system", "oldNames": ["40"] } },
    "52": { "$type": "dimension", "$value": "52px", "$extensions": { "status": "system", "oldNames": ["48"] } },
    "84": { "$type": "dimension", "$value": "84px", "$extensions": { "status": "experimental" } },
    "136": { "$type": "dimension", "$value": "136px", "$extensions": { "status": "experimental" } }
  },
  "scale": {
    "90": { "$type": "number", "$value": 0.9, "$extensions": { "status": "system", "oldNames": ["60", "75"] } },
    "95": { "$type": "number", "$value": 0.95, "$extensions": { "status": "system", "oldNames": ["96", "97", "98"] } },
    "100": { "$type": "number", "$value": 1, "$extensions": { "status": "system", "oldNames": ["99", "103", "106"] } }
  },
  "opacity": {
    "0": { "$type": "number", "$value": 0, "$extensions": { "status": "system", "oldNames": ["04", "08", "10"] } },
    "100": { "$type": "number", "$value": 1, "$extensions": { "status": "system", "oldNames": ["56"] } }
  },
  "delay": {
    "40": { "$type": "duration", "$value": "40ms", "$extensions": { "status": "system" } },
    "80": { "$type": "duration", "$value": "80ms", "$extensions": { "status": "system", "oldNames": ["70"] } },
    "120": { "$type": "duration", "$value": "120ms", "$extensions": { "status": "system" } }
  },
  "$extensions": {
    "scale": {
      "kinds": {
        "distance": {
          "scale": "fibonacci"
        },
        "delay": {
          "scale": "fibonacci"
        }
      }
    }
  }
}
