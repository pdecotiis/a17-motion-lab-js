{
  "name": "a17-motion-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "predev": "node scripts/doctor.mjs --quick",
    "dev": "vite",
    "build": "vite build",
    "build:small": "vite build && vite-node scripts/optimize-dist.ts --",
    "typecheck": "vite-node scripts/typecheck.ts",
    "postinstall": "node scripts/setup-git.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:fast": "playwright test --project=chromium",
    "figma:import": "vite-node scripts/figma-import/cli.ts --",
    "figma:import-page": "vite-node scripts/figma-import/page-cli.ts --",
    "spec": "vite-node scripts/export-spec.ts --",
    "tokens:scale": "vite-node scripts/scale-tokens.ts --",
    "tokens:remap": "vite-node scripts/tokens-remap.ts --",
    "precheck": "node scripts/doctor.mjs --for check",
    "check": "npm run typecheck && npm run test && npm run build && npm run test:e2e",
    "check:fast": "npm run typecheck && npm run test && npm run test:e2e:fast",
    "check:changed": "node scripts/check-changed.mjs",
    "check:all": "LAB_TESTS=1 WEBKIT_ALL=1 npm run check"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "gsap": "^3.15.0",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-node": "^6.0.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "motion": "^14.9.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
